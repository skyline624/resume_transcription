# Token HuggingFace, type "read".
# Requis uniquement si ENABLE_DIARIZATION=true.
# Accepter au prealable les conditions de
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
ENABLE_DIARIZATION=true

DEVICE=cuda
COMPUTE_TYPE=float16

# Silero repere les passages parles avant l'inference Parakeet. Le CPU suffit
# generalement et laisse toute la VRAM a l'ASR et a la diarization.
ENABLE_VAD=true
VAD_DEVICE=cpu
VAD_MAX_SEGMENT_S=5
VAD_FALLBACK_OVERLAP_S=1

CHUNK_LENGTH_S=480
CHUNK_OVERLAP_S=15
TURN_GAP_S=1.0

HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=1024

# --- Compte-rendu ---
# Le modele doit exister dans votre installation Ollama (ollama list).
# Un modele « :cloud » fait transiter la conversation par les serveurs
# d'Ollama : a ne poser qu'en connaissance de cause.
SUMMARY_MODEL=qwen3.8-27b-unc-32k:latest
# Depuis le conteneur, l'hote se joint par ce nom sous Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
ENABLE_SUMMARY=true
SUMMARY_TIMEOUT_S=900

# --- Synthèse vocale Qwen3-TTS ---
ENABLE_TTS=true
TTS_WORKER_SOCKET=/run/qwen-tts/worker.sock
TTS_CUSTOM_VOICE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_CLONE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
TTS_VOICE_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_PRELOAD_MODELS=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice,Qwen/Qwen3-TTS-12Hz-1.7B-Base,Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_DEFAULT_LANGUAGE=fr
TTS_PRECISION=bfloat16
TTS_ATTENTION_IMPLEMENTATION=sdpa
TTS_IDLE_UNLOAD_S=300
TTS_LOAD_TIMEOUT_S=300
TTS_GENERATION_TIMEOUT_S=900
TTS_MAX_INPUT_CHARS=4096
TTS_REFERENCE_MIN_S=3
TTS_REFERENCE_MAX_S=30
TTS_REFERENCE_MIN_DBFS=-60
TTS_REFERENCE_MAX_CLIPPED_RATIO=0.01
VOICE_STORE_PATH=/app/voices
