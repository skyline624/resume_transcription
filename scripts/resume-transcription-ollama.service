[Unit]
Description=Ollama pour les comptes-rendus de transcription
After=network-online.target
ConditionPathIsMountPoint=/mnt/donnees

[Service]
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/mnt/donnees/resume_transcription/runtime/ollama
Environment=OLLAMA_KEEP_ALIVE=0
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
